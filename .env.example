# Copy to .env.local and fill in from Supabase dashboard → Project Settings → API.
# Only the public anon key belongs here. NEVER put the service_role key in the web app.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Development only — password shared by the test users created by supabase/seed.sql.
# Read by the dev user switcher, which Vite strips from production builds.
VITE_DEV_USER_PASSWORD=kanban-dev-2026
